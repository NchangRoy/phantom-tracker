BPF_CC ?= clang
CC     ?= gcc

ARCH ?= $(shell uname -m | sed -e 's/x86_64/x86/' -e 's/aarch64/arm64/')
BPF_CFLAGS ?= -target bpf -O2 -g -Wall -Wextra -Wno-unused-parameter -D__TARGET_ARCH_$(ARCH)
BPF_CFLAGS += -DPVSCHED_IVSHMEM_PAGE_SIZE=$(shell getconf PAGE_SIZE)

CFLAGS ?= -O2 -g -Wall -Wextra

# Path to the libgomp shared library the loader attaches its USDT probes to.
# Must be set explicitly, e.g.:
#   make LIBGOMP_PATH=/home/fureh_mitoto/gcc-install/lib64/libgomp.so.1
LIBGOMP_PATH ?=

ifeq ($(filter clean,$(MAKECMDGOALS)),)
ifeq ($(LIBGOMP_PATH),)
$(error LIBGOMP_PATH is not set. Build with: make LIBGOMP_PATH=/path/to/libgomp.so.1)
endif
endif

# Output directory — all generated files land here
BINDIR := ../bin

# Shared project headers (pvsched.h, etc.)
PROJECT_INCLUDE := ../../include

LOCAL_INCLUDE := .

# libbpf flags resolved via pkg-config with a fallback
LIBBPF_CFLAGS := $(shell pkg-config --cflags libbpf 2>/dev/null)
LIBBPF_LIBS   := $(shell pkg-config --libs   libbpf 2>/dev/null || echo -lbpf -lelf -lz)

# Paths searched during BPF compilation (include BINDIR so vmlinux.h is found).
# usdt.bpf.h pulls in <linux/errno.h> -> <asm/errno.h>; clang -target bpf
# doesn't inherit gcc's multiarch search path, so it has to be added explicitly.
BPF_INCLUDE := -I$(LOCAL_INCLUDE) -I$(BINDIR) -I/usr/include -I/usr/include/$(shell $(CC) -dumpmachine) -I$(PROJECT_INCLUDE)

# -----------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------
.PHONY: all clean check

all: $(BINDIR) $(BINDIR)/read_phantom_avg $(BINDIR)/barrier_sync.loader

# -----------------------------------------------------------------------
# Output directory
# -----------------------------------------------------------------------
$(BINDIR):
	mkdir -p $@

# -----------------------------------------------------------------------
# vmlinux.h  — generated from the running kernel's BTF, placed in BINDIR
# -----------------------------------------------------------------------
$(BINDIR)/vmlinux.h: | $(BINDIR)
	bpftool btf dump file /sys/kernel/btf/vmlinux format c > $@

# -----------------------------------------------------------------------
# BPF object  — compiled with clang targeting the BPF backend
# -----------------------------------------------------------------------
$(BINDIR)/barrier_sync.bpf.o: barrier_sync.bpf.c \
                               $(BINDIR)/vmlinux.h \
                               $(PROJECT_INCLUDE)/pvsched.h \
                               | $(BINDIR)
	$(BPF_CC) $(BPF_CFLAGS) $(BPF_INCLUDE) -c $< -o $@

# -----------------------------------------------------------------------
# BPF skeleton  — generated by bpftool from the BPF object
# -----------------------------------------------------------------------
$(BINDIR)/barrier_sync.skel.h: $(BINDIR)/barrier_sync.bpf.o
	bpftool gen skeleton $< > $@

# -----------------------------------------------------------------------
# Loader binary  — userspace C program that loads and attaches the BPF progs
# -----------------------------------------------------------------------
$(BINDIR)/barrier_sync.loader: barrier_sync.loader.c \
                                $(BINDIR)/barrier_sync.skel.h \
                                $(PROJECT_INCLUDE)/pvsched.h \
                                | $(BINDIR)
	$(CC) $(CFLAGS) $(LIBBPF_CFLAGS) -DLIBGOMP_PATH=\"$(LIBGOMP_PATH)\" \
	      -I$(LOCAL_INCLUDE) -I$(BINDIR) -I$(PROJECT_INCLUDE) \
	      $< -o $@ $(LIBBPF_LIBS)

# -----------------------------------------------------------------------
# Read phantom avg utility
# -----------------------------------------------------------------------
$(BINDIR)/read_phantom_avg: read_phantom_avg.c | $(BINDIR)
	$(CC) $(CFLAGS) -I$(LOCAL_INCLUDE) -I$(PROJECT_INCLUDE) $< -o $@



# -----------------------------------------------------------------------
# Sanity checks
# -----------------------------------------------------------------------
check:
	@command -v $(BPF_CC)  > /dev/null || { echo "missing BPF compiler: $(BPF_CC)";  exit 1; }
	@command -v bpftool    > /dev/null || { echo "missing bpftool";                   exit 1; }
	@pkg-config --exists libbpf || echo "warning: pkg-config cannot find libbpf"
	@test -f $(PROJECT_INCLUDE)/pvsched.h || \
	    { echo "missing shared header: $(PROJECT_INCLUDE)/pvsched.h"; exit 1; }

# -----------------------------------------------------------------------
# Clean
# -----------------------------------------------------------------------
clean:
	rm -f $(BINDIR)/vmlinux.h \
	      $(BINDIR)/barrier_sync.bpf.o \
	      $(BINDIR)/barrier_sync.skel.h \
	      $(BINDIR)/barrier_sync.loader
