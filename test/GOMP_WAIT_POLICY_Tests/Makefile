BPF_CC ?= bpf-gcc
CC     ?= gcc

# bpf-gcc targets BPF natively — no -target bpf flag needed.
# -gbtf emits BTF debug info required by bpftool gen skeleton.
# -D__TARGET_ARCH_x86 matches the host Makefile convention.
BPF_PROG_CFLAGS ?= -O2 -gbtf -Wall -Wextra -Wno-unused-parameter
BPF_PROG_CFLAGS += -D__TARGET_ARCH_x86
BPF_PROG_CFLAGS += -DPVSCHED_IVSHMEM_PAGE_SIZE=$(shell getconf PAGE_SIZE)

CFLAGS ?= -O2 -g -Wall -Wextra

# Output directory for compiled binaries
BINDIR := ../bin

# Shared project headers (pvsched.h, etc.)
PROJECT_INCLUDE := ../../include

# find_do_wait.h lives in this directory
LOCAL_INCLUDE := .

# libbpf flags resolved via pkg-config with a fallback
LIBBPF_CFLAGS := $(shell pkg-config --cflags libbpf 2>/dev/null)
LIBBPF_LIBS   := $(shell pkg-config --libs   libbpf 2>/dev/null || echo -lbpf -lelf -lz)

# Paths searched during BPF compilation
BPF_INCLUDE := -I$(LOCAL_INCLUDE) -I/usr/include -I$(PROJECT_INCLUDE)

# -----------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------
.PHONY: all clean check

all: $(BINDIR) $(BINDIR)/find_do_wait $(BINDIR)/GOMP_WAIT_POLICY_test.loader

# -----------------------------------------------------------------------
# Output directory
# -----------------------------------------------------------------------
$(BINDIR):
	mkdir -p $@

# -----------------------------------------------------------------------
# vmlinux.h  — generated from the running kernel's BTF
# -----------------------------------------------------------------------
vmlinux.h:
	bpftool btf dump file /sys/kernel/btf/vmlinux format c > $@

# -----------------------------------------------------------------------
# BPF object  — compiled with clang targeting the BPF backend
# -----------------------------------------------------------------------
GOMP_WAIT_POLICY_test.bpf.o: GOMP_WAIT_POLICY_test.bpf.c vmlinux.h \
                              $(PROJECT_INCLUDE)/pvsched.h
	$(BPF_CC) $(BPF_PROG_CFLAGS) $(BPF_INCLUDE) -c $< -o $@

# -----------------------------------------------------------------------
# BPF skeleton  — generated by bpftool from the BPF object
# -----------------------------------------------------------------------
GOMP_WAIT_POLICY_test.skel.h: GOMP_WAIT_POLICY_test.bpf.o
	bpftool gen skeleton $< > $@

# -----------------------------------------------------------------------
# Loader binary  — userspace C program that loads and attaches the BPF progs
# -----------------------------------------------------------------------
$(BINDIR)/GOMP_WAIT_POLICY_test.loader: GOMP_WAIT_POLICY_test.loader.c \
                                        GOMP_WAIT_POLICY_test.skel.h \
                                        find_do_wait.h \
                                        $(PROJECT_INCLUDE)/pvsched.h \
                                        | $(BINDIR)
	$(CC) $(CFLAGS) $(LIBBPF_CFLAGS) \
	      -I$(LOCAL_INCLUDE) -I$(PROJECT_INCLUDE) \
	      $< -o $@ $(LIBBPF_LIBS)

# -----------------------------------------------------------------------
# Standalone do_wait offset finder (test / debug tool)
# No BPF or libbpf dependency — plain C.
# -----------------------------------------------------------------------
$(BINDIR)/find_do_wait: find_do_wait.c find_do_wait.h | $(BINDIR)
	$(CC) $(CFLAGS) -I$(LOCAL_INCLUDE) $< -o $@

# -----------------------------------------------------------------------
# Sanity checks
# -----------------------------------------------------------------------
check:
	@command -v $(BPF_CC)  > /dev/null || { echo "missing BPF compiler: $(BPF_CC)";  exit 1; }
	@command -v bpftool    > /dev/null || { echo "missing bpftool";                   exit 1; }
	@command -v objdump    > /dev/null || { echo "missing objdump (binutils)";         exit 1; }
	@pkg-config --exists libbpf || echo "warning: pkg-config cannot find libbpf"
	@test -f $(PROJECT_INCLUDE)/pvsched.h || \
	    { echo "missing shared header: $(PROJECT_INCLUDE)/pvsched.h"; exit 1; }

# -----------------------------------------------------------------------
# Clean
# -----------------------------------------------------------------------
clean:
	rm -f vmlinux.h \
	      GOMP_WAIT_POLICY_test.bpf.o \
	      GOMP_WAIT_POLICY_test.skel.h \
	      $(BINDIR)/GOMP_WAIT_POLICY_test.loader \
	      $(BINDIR)/find_do_wait
